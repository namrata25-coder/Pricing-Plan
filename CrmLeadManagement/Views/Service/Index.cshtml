@model PortfolioServicePageViewModel
@{
    ViewData["Title"] = "Service Management";
    ViewData["ActivePage"] = "PortfolioService";
    var canCreate = ViewData["CanCreateService"] is true;
    var canEdit = ViewData["CanEditService"] is true;
    var canDelete = ViewData["CanDeleteService"] is true;
    var isEditing = Model.EditingServiceId.HasValue;
}

<div style="max-width:1200px;margin:0 auto;padding:1.5rem 1.75rem;">
    <div style="margin-bottom:1.5rem;">
        <div style="font-size:12px;font-weight:600;color:var(--ink-500);text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px;">Portfolio Management</div>
        <h1 style="font-size:1.6rem;font-weight:800;color:var(--ink-900);margin:0;">
            <i class="bi bi-window-stack" style="color:var(--brand-600);margin-right:8px;"></i>Service Management
        </h1>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    @if (canCreate || isEditing)
    {
        <section style="background:#fff;border:1px solid var(--line);border-radius:12px;padding:1.5rem;margin-bottom:1.5rem;box-shadow:0 1px 3px rgba(0,0,0,.03);">
            <h2 style="font-size:1.1rem;font-weight:700;color:var(--ink-800);margin:0 0 1.25rem;">@(isEditing ? "Update Service" : "Add Service")</h2>
            <form asp-action="@(isEditing ? "Update" : "Create")" asp-route-id="@Model.EditingServiceId" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" style="color:#dc2626;background:#fef2f2;border:1px solid #fecaca;border-radius:8px;padding:10px 12px;margin-bottom:1rem;"></div>

                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1rem;">
                    <div>
                        <label asp-for="Input.ProjectName" style="display:block;font-size:13px;font-weight:600;margin-bottom:6px;">Project Name <span style="color:#ef4444;">*</span></label>
                        <input asp-for="Input.ProjectName" maxlength="200" required placeholder="Enter project name"
                               style="width:100%;padding:9px 12px;border:1.5px solid var(--line);border-radius:9px;font-size:13px;" />
                        <span asp-validation-for="Input.ProjectName" style="color:#ef4444;font-size:12px;"></span>
                    </div>
                    <div>
                        <label asp-for="Input.Type" style="display:block;font-size:13px;font-weight:600;margin-bottom:6px;">Type <span style="color:#ef4444;">*</span></label>
                        <select asp-for="Input.Type" required style="width:100%;padding:9px 12px;border:1.5px solid var(--line);border-radius:9px;font-size:13px;background:#fff;">
                            <option value="">Select type</option>
                            <option value="Web">Web</option>
                            <option value="App">App</option>
                        </select>
                        <span asp-validation-for="Input.Type" style="color:#ef4444;font-size:12px;"></span>
                    </div>
                    <div>
                        <label asp-for="Input.Price" style="display:block;font-size:13px;font-weight:600;margin-bottom:6px;">Price <span style="color:#ef4444;">*</span></label>
                        <input asp-for="Input.Price" type="number" min="0" step="0.01" required placeholder="0.00"
                               style="width:100%;padding:9px 12px;border:1.5px solid var(--line);border-radius:9px;font-size:13px;" />
                        <span asp-validation-for="Input.Price" style="color:#ef4444;font-size:12px;"></span>
                    </div>
                    <div>
                        <label asp-for="Input.DemoLink" style="display:block;font-size:13px;font-weight:600;margin-bottom:6px;">Demo Link</label>
                        <input asp-for="Input.DemoLink" maxlength="2048" placeholder="www.example.com/demo"
                               style="width:100%;padding:9px 12px;border:1.5px solid var(--line);border-radius:9px;font-size:13px;" />
                        <span asp-validation-for="Input.DemoLink" style="color:#ef4444;font-size:12px;"></span>
                    </div>
                    <div style="grid-column:1/-1;">
                        <label asp-for="Input.Description" style="display:block;font-size:13px;font-weight:600;margin-bottom:6px;">Description <span style="color:#ef4444;">*</span></label>
                        <textarea asp-for="Input.Description" rows="3" maxlength="4000" required placeholder="Describe the service"
                                  style="width:100%;padding:9px 12px;border:1.5px solid var(--line);border-radius:9px;font-size:13px;resize:vertical;"></textarea>
                        <span asp-validation-for="Input.Description" style="color:#ef4444;font-size:12px;"></span>
                    </div>
                    <div style="grid-column:1/-1;">
                        <label asp-for="Input.Features" style="display:block;font-size:13px;font-weight:600;margin-bottom:6px;">Features <span style="color:#ef4444;">*</span></label>
                        <textarea asp-for="Input.Features" rows="4" maxlength="4000" required placeholder="Enter one feature per line"
                                  style="width:100%;padding:9px 12px;border:1.5px solid var(--line);border-radius:9px;font-size:13px;resize:vertical;"></textarea>
                        <small style="color:var(--ink-400);">Enter one feature per line.</small>
                        <span asp-validation-for="Input.Features" style="color:#ef4444;font-size:12px;display:block;"></span>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary" style="display:inline-flex;align-items:center;gap:7px;margin-top:1rem;font-weight:600;">
                    <i class="bi bi-check-lg"></i> @(isEditing ? "Update Service" : "Save Service")
                </button>
                @if (isEditing)
                {
                    <a asp-action="Index" class="btn btn-outline" style="margin-top:1rem;">Cancel</a>
                }
            </form>
        </section>
    }

    <section style="background:#fff;border:1px solid var(--line);border-radius:12px;overflow:hidden;box-shadow:0 1px 3px rgba(0,0,0,.03);">
        <div style="padding:1rem 1.25rem;border-bottom:1px solid var(--line);font-size:14px;font-weight:700;color:var(--ink-700);">Saved Services</div>
        @if (Model.Services.Count == 0)
        {
            <p style="padding:1.5rem;color:var(--ink-500);margin:0;">No services have been added yet.</p>
        }
        else
        {
            <div style="overflow-x:auto;">
                <table class="table-custom" style="width:100%;min-width:800px;border-collapse:collapse;text-align:left;font-size:13px;">
                    <thead style="background:#f8fafc;">
                        <tr>
                            <th style="padding:12px 14px;">Project Name</th>
                            <th style="padding:12px 14px;">Industry</th>
                            <th style="padding:12px 14px;">Type</th>
                            <th style="padding:12px 14px;">Description</th>
                            <th style="padding:12px 14px;">Features</th>
                            <th style="padding:12px 14px;text-align:right;">Price</th>
                            <th style="padding:12px 14px;">Demo Link</th>
                            @if (canEdit || canDelete)
                            {
                                <th style="padding:12px 14px;text-align:center;">Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var service in Model.Services)
                        {
                            <tr style="border-top:1px solid var(--line);">
                                <td style="padding:12px 14px;font-weight:700;">@service.ProjectName</td>
                                <td style="padding:12px 14px;">@service.Category</td>
                                <td style="padding:12px 14px;">@service.Type</td>
                                <td style="padding:12px 14px;max-width:240px;white-space:pre-line;">@service.Description</td>
                                <td style="padding:12px 14px;max-width:220px;white-space:pre-line;">@service.Features</td>
                                <td style="padding:12px 14px;text-align:right;white-space:nowrap;">@service.Price.ToString("0.00")</td>
                                <td style="padding:12px 14px;max-width:200px;overflow-wrap:anywhere;">
                                    @if (!string.IsNullOrWhiteSpace(service.DemoLink))
                                    {
                                        <a href="@service.DemoLink" target="_blank" rel="noopener noreferrer">@service.DemoLink</a>
                                    }
                                    else
                                    {
                                        <span style="color:var(--ink-400);">—</span>
                                    }
                                </td>
                                @if (canEdit || canDelete)
                                {
                                    <td style="padding:10px 12px;text-align:center;white-space:nowrap;">
                                        @if (canEdit)
                                        {
                                            <a asp-action="Index" asp-route-editId="@service.Id" class="btn btn-sm btn-outline" title="Edit service">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        }
                                        @if (canDelete)
                                        {
                                            <form asp-action="Delete" asp-route-id="@service.Id" method="post" style="display:inline;"
                                                  onsubmit="return confirm('Delete this service?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline" title="Delete service" style="color:#dc2626;">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
